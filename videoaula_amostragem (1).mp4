      <span class="kicker">Sistema Multimídia</span>
      <h1><span class="sr">DggSounds</span><svg class="logo-hero" viewBox="40 30 915 230" aria-hidden="true" aria-label="DggSounds"><g fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
    <!-- D (triângulo / play) -->
    <path d="M60 45 L180 133 L60 240 Z"/>
    <!-- G -->
    <path d="M292 65 H236 L218 84 V180 L240 197 H286 L312 162 V145 H268 V166"/>
    <path d="M292 65 L310 84"/>
    <!-- G -->
    <path d="M414 65 H358 L340 84 V180 L362 197 H408 L434 162 V145 H390 V166"/>
    <path d="M414 65 L432 84"/>
    <!-- S -->
    <path d="M540 68 H455 V130 H540 V195 H455"/>
    <!-- O -->
    <path d="M570 70 H645 V195 H570 Z"/>
    <!-- U -->
    <path d="M668 70 V195 H740 V70"/>
    <!-- N + D -->
    <path d="M765 195 V70 L800 195 V70 L860 135 L800 195"/>
